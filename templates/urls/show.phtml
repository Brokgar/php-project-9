        <?php $title = $check['title'] ?? ''; ?>
        <?php $title = mb_strlen($title) > 200 ? mb_substr($title, 0, 200) . '...' : $title; ?>
        <?php $description = $check['description'] ?? ''; ?>
        <?php $description = mb_strlen($description) > 120
            ? mb_substr($description, 0, 120) . '...'
            : $description; ?>
        <tr>
          <td><?= htmlspecialchars((string) $check['id']) ?></td>
          <td><?= htmlspecialchars((string) ($check['status_code'] ?? '')) ?></td>
