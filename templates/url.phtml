<?php
$shorten = static function (?string $value): string {
    $value ??= '';
    $suffix = '...';
    $limit = 200;

    if (iconv_strlen($value, 'UTF-8') <= $limit) {
        return $value;
    }

    return iconv_substr($value, 0, $limit, 'UTF-8') . $suffix;
};
